{
  "name": "gopeshwar-stationary-house",
  "version": "0.1.0",
  "private": true,
  "description": "GSH — AI-powered retail intelligence for Gopeshwar Stationary House. Android-first, web-secondary.",
  "scripts": {
    "build": "node scripts/build-web.mjs",
    "cap:add-android": "npx cap add android",
    "cap:sync": "npx cap sync android",
    "cap:open": "npx cap open android",
    "cap:build": "npm run build && npx cap sync android",
    "typecheck": "tsc --noEmit",
    "db:migrate": "prisma migrate dev",
    "db:generate": "prisma generate",
    "db:seed": "tsx server/seed.ts"
  },
  "dependencies": {
    "@capacitor/core": "^6.1.2",
    "@capacitor/android": "^6.1.2",
    "@capacitor/camera": "^6.0.2",
    "@capacitor/preferences": "^6.0.2",
    "@capacitor/local-notifications": "^6.1.0",
    "@capacitor/filesystem": "^6.0.2",
    "@capacitor/share": "^6.0.2",
    "@capacitor/app": "^6.0.1",
    "capacitor-native-biometric": "^4.2.1"
  },
  "devDependencies": {
    "typescript": "^5.5.4",
    "@capacitor/cli": "^6.1.2",
    "prisma": "^5.18.0",
    "@prisma/client": "^5.18.0",
    "tsx": "^4.16.5",
    "@types/node": "^20.14.0"
  }
}
